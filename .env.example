SPRING_ACTIVE_PROFILE=dev

# Подключение к БД - ${DB_HOST}:${DB_PORT}/${DB_NAME}
# ВАЖНО: если приложение и БД в Docker — используйте имя сервиса (например, "shop_db"),
# а не "localhost"
DB_HOST=shop_db
DB_PORT=5432
DB_NAME=shop_db
DB_USER=postgres
DB_PASSWORD=change_me

# Подключение к RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change_me

# JWT - секрет для подписи (минимум 32 байта для HS256)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_bytes
